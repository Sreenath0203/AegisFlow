# AegisFlow Environment Configuration

# Application Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration
# Uses PostgreSQL if available, otherwise defaults to local SQLite file: sqlite:///./aegisflow.db
DATABASE_URL=sqlite:///./aegisflow.db
# For PostgreSQL use: postgresql://postgres:postgres@localhost:5432/aegisflow

# IBM watsonx.ai & IBM Granite Configuration
# Set these variables with your actual IBM Cloud / watsonx.ai credentials
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
MODEL_ID=ibm/granite-13b-instruct-v2

# IBM RAG & Knowledge Service Configuration
WATSONX_RAG_COLLECTION_ID=supply_chain_contracts_v1

# IBM Data Prep Kit Settings
DATA_PREP_KIT_ENABLED=true
